# PortföyOS — Ortam değişkenleri örneği.
# Bu dosyayı `.env.local` olarak kopyalayıp doldur. `.env.local` ASLA commit edilmez.
# Firebase web config client'a açıktır (gizli DEĞİL); koruma Firestore Rules + App Check iledir.
# Firebase ayarlanmazsa uygulama otomatik olarak YEREL DEMO MODUNDA çalışır.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=        # web push için (opsiyonel)

# App Check (reCAPTCHA v3) — sahte istemcileri Firebase'den ve /api'den engeller.
# reCAPTCHA v3 SITE anahtarı gizli DEĞİLDİR (client'a açıktır); SECRET anahtarı
# Firebase Console'a girilir, buraya GİRMEZ. Bu değer boşken App Check pasiftir.
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_KEY=
# Yerel geliştirme için App Check debug token (tarayıcı konsolundan alınır, opsiyonel):
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# SADECE sunucu — NEXT_PUBLIC OLMAYACAK, repoya girmeyecek.
# App Check token'ı /api'de zorunlu kılmak için (konsolda App Check'i kurup test
# ettikten SONRA "true" yap — erkense istekler reddedilir):
# APPCHECK_ENFORCE=true
#
# Otomatik fiyat çekme varsayılan olarak anahtarsız kaynaklarla çalışır
# (TEFAS fonları, Yahoo Finance BIST hisseleri, TCMB döviz kurları).
# Premium/alternatif bir kaynak kullanacaksan anahtarı yalnızca burada tut:
# PRICE_API_KEY=
# TEFAS_SOURCE_URL=
